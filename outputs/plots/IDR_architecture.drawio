        <mxCell id="2 ·n5" value="&lt;b&gt;4 · Sync&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#444'&gt;two-stage alignment&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;verticalAlign=middle;align=center;spacingTop=2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="988" y="170" width="230" height="96" as="geometry"/></mxCell>
